# ВАЖНО: проект diploma-fix должен жить рядом с исходным diplom-* без конфликтов.
# Все порты сдвинуты от стандартных, чтобы можно было поднять обе системы одновременно.

# ========== PostgreSQL ==========
POSTGRES_USER=diplom
POSTGRES_PASSWORD=changeme_postgres
CORE_DB_NAME=core_db
ANALYSIS_DB_NAME=analysis_db
POSTGRES_PORT=15432

# ========== MinIO ==========
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# ========== ClickHouse ==========
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme_clickhouse
CLICKHOUSE_DB=analysis_metrics
CLICKHOUSE_PORT=18123
CLICKHOUSE_NATIVE_PORT=19100

# ========== Redis ==========
REDIS_PASSWORD=changeme_redis
REDIS_PORT=16379

# ========== Kafka ==========
KAFKA_BROKER_PORT=19092

# ========== JWT ==========
JWT_SECRET=changeme_jwt_secret_256bit

# Dev-token для analysis-api без core-api (docker-compose.hybrid.yml)
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=dev@analysis.local
DEV_USER_ROLE=admin

# ========== Services ==========
CORE_API_PORT=8081
ANALYSIS_API_PORT=8082
NGINX_PORT=8080
